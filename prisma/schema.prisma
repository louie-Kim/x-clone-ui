// npm install prisma
// npx prisma init 하면 생기는 파일
generator client {
  provider = "prisma-client-js"
}

datasource db {
  // docker의 mysql 컨테이너에 연결
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id
  email       String   @unique
  username    String   @unique
  displayName String?
  bio         String?
  location    String?
  job         String?
  website     String?
  img         String?
  cover       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // RELATIONS - FK
  posts Post[]

  likes Like[]

  saves SavedPosts[]

  // 내가 팔로우하는 정보
  followers  Follow[] @relation("UserFollowers") // 같은 alias로 맵핑
  //  follower  User @relation("UserFollowers", fields: [followerId], references: [id]) 
  // ->  followerId  String -> followers[] 연결
  /**
  ex)
  followings, followers: [
    Follow 모델 객체들이 들어갑니다
    {
      id: 1,
      createdAt: 2025-03-27T09:32:32.780Z,
      followerId: 'user_2vASAZAR6tamMfFS997GSE6gOcw',
      followingId: 'user2'
    }
  ]
  */
  // 내를 팔로우하는 정보 
  followings Follow[] @relation("UserFollowings") 
  //  following User @relation("UserFollowings", fields: [followingId], references: [id]) 
  // -> followingId String -> followings[] 연결

}

// 배열([])로 정의된 필드 : 부모 -> 1 (post): N ( 여러개) 관계
// userId: String → User 모델의 자식
// rePostId : post.id의 → 자식
// parentPostId :post.id의 → 자식
model Post {
  // @id : 해당 필드가 데이터베이스의 기본 키(Primary Key) 임을 나타냄
  id          Int      @id @default(autoincrement()) // 부모 
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  desc        String?  @db.VarChar(255)
  img         String?
  imgHeight   Int?
  video       String?
  isSensitive Boolean  @default(false)

  // RELATIONS - User의 자식
  user   User   @relation(fields: [userId], references: [id])
  userId String // 작성자


  // Post.rePost = 원본글
  
  /**
  id	   desc	           rePostId
  14	  "원본 게시글"	    null
  64	  "리포스트한 글"	  14
    
  // id=14인 게시물의 시점에서 보면
  rePosts = [{ id: 64 }] 

  // id=64인 게시물의 시점에서는
  rePostId = 14          // 원본 글의 id를 참조

  */
  rePostId Int? // 자식 필드
  rePost   Post?  @relation("RePosts", fields: [rePostId], references: [id])
  // 원본 게시물 입장에서 자신을 리포스트한 게시물 Id
  // rePosts: [ { id: 64 } ], 
  rePosts  Post[] @relation("RePosts") 

  
  /**
  id | desc                          | parentPostId
  14 | "원본 게시글"                 | null
  39 | "Comment on Post 14 by user5" | 14
    
  id: 14 → 원본 게시물

  id: 39 → parentPostId: 14이므로, id=14 게시물에 달린 댓글

  그리고 39는 이 댓글(Post)의 Primary Key (PK)
  */

  parentPostId Int? // 자식 필드 ★ 원글의 id
  parentPost   Post?  @relation("PostComments", fields: [parentPostId], references: [id])
  comments     Post[] @relation("PostComments")

  likes Like[]
  saves SavedPosts[]
}

model Like {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  // RELATIONS - FK
  userId String
  postId Int

  // User, Post 모델과의 관계 설정
  user User @relation(fields: [userId], references: [id])
  post Post @relation(fields: [postId], references: [id])
}

model SavedPosts {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  // RELATIONS- FK
  userId String
  postId Int

  
  user User @relation(fields: [userId], references: [id])
  post Post @relation(fields: [postId], references: [id])
}

// User의 중간 테이블
model Follow {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  // RELATIONS- FK
  followerId  String  // 팔로우하는 사람의  id
  followingId String  // 팔로우 당하는 사람의 id

  // User  모델을 두번 참조
  follower  User @relation("UserFollowers", fields: [followerId], references: [id])
  following User @relation("UserFollowings", fields: [followingId], references: [id])
}


